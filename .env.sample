# Optional per-run overrides for start.sh.
#
# cp .env.sample .env   (the real .env is not tracked by git).
# Precedence: shell env > ./.env > start.sh defaults.

# --- Cluster (one server across several nodes) ---

# Node count (TP = EP = GPUs per node * NNODES). 1 = single node.
# NNODES=1

# This node's rank, 0..NNODES-1. Only rank 0 serves the API.
# NODE_RANK=0

# IP of the rank-0 node; required when NNODES > 1.
# MASTER_ADDR=10.0.0.1

# Rendezvous port (--dist-init-addr); must be reachable between nodes.
# DIST_PORT=20000

# NCCL/GLOO network interface, if NCCL picks the wrong one.
# NCCL_SOCKET_IFNAME=eth0

# InfiniBand/RoCE HCAs for NCCL (prefix match), e.g. mlx5.
# NCCL_IB_HCA=mlx5

# NCCL log level; INFO shows which transport each link uses.
# NCCL_DEBUG=INFO

# --- Single node / model ---

# This node's GPUs (2, 4 or 8). TP = EP = GPUs per node * NNODES. 8 on H200 is the verified
# recipe; 4x H200 is tight (16 requests, capped context, see CONTEXT_LENGTH).
# Memory-based limits: < 500 GiB total is rejected (~510GB of weights).
GPU_ID=0,1,2,3,4,5,6,7

# API bind address and port.
HOST=0.0.0.0
PORT=8000

# SGLang image (DeepSeek-V4.1 is not in a release yet; preview build).
IMAGE=lmsysorg/sglang:dev-dsv41

# Fraction of GPU memory for weights + KV cache.
# Default: 0.8 on 8 GPUs (cookbook), 0.92 on 4 GPUs.
# MEM_FRACTION=0.8

# Thinking when the request sends no reasoning_effort (0 = off, 1 = on).
THINKING=0

# DSpark speculative decoding, the model's bundled draft (0 = off, 1 = on).
# Not in the verified H200 recipe.
DSPARK=0

# HuggingFace cache on the host (~510GB for this model).
# HF_CACHE=/data/huggingface

# Optional; DeepSeek-V4.1-Flash is public, a token only raises Hub rate limits.
# HF_TOKEN=

# 4-GPU only: context window cap (default 65536). Raise it if the server boots
# and KV memory allows; lower it if it fails to start. Ignored on 8 GPUs.
# CONTEXT_LENGTH=65536

# Extra SGLang flags, appended last (override anything above).
# EXTRA_ARGS=--max-running-requests 256
